# Copy this file to ".env.local" for local testing.
# On Vercel, add the same 3 names in: Project -> Settings -> Environment Variables.

# Supabase -> "Connect" button (top of dashboard) -> App Frameworks -> Next.js
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
# The "publishable" key (starts with sb_publishable_) or the legacy "anon" key.
# This key is SAFE for the browser. Never use the "secret" / "service_role" key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# The only email allowed to log in to /admin.
ADMIN_EMAIL=victoradoji4@gmail.com
